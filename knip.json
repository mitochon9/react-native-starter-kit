{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "index.js",
    "src/app/**/{page,layout,loading,error,not-found,_layout,index}.{ts,tsx}",
    "src/app/**/*.tsx",
    "scripts/**/*.js",
    "steiger.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.js"],
  "ignore": [
    "**/*.d.ts",
    "**/node_modules/**",
    "temp/**",
    "docs/**",
    "metro.config.js",
    "android/**",
    "ios/**",
    ".expo/**"
  ],
  "ignoreDependencies": ["expo-updates"],
  "ignoreBinaries": ["eas"],
  "ignoreExportsUsedInFile": true
}
